  "findings": [
    {
      "title": "Finding 1: Non-Linear Acceleration in Enterprise AI Adoption (2020-2023)",
      "summary": "Enterprise AI adoption more than tripled from 14.2% in 2020 to 44.0% in 2023. Concurrently, ICM Value Added grew from SGD 25.4B to SGD 38.6B (+52.0%), reflecting surging productivity and commercial deployment across enterprise workflows.",
      "data_points": {
        "ai_adoption_rates_pct": {
          "2020": 14.2,
          "2021": 22.5,
          "2022": 31.8,
          "2023": 44.0
        },
        "sector_value_added_billion_sgd": {
          "2018": 19.2,
          "2019": 22.1,
          "2020": 25.4,
          "2021": 29.8,
          "2022": 34.2,
          "2023": 38.6
        }
      },
      "ascii_chart": "AI Adoption Trajectory (% of Enterprises adopting AI):\n2020 | [====] 14.2%\n2021 | [=======] 22.5%\n2022 | [==========] 31.8%\n2023 | [============== ] 44.0%\n"
    },
    {
      "title": "Finding 2: Deep Tech Wage Divergence and Rapid Expansion in AI Roles",
      "summary": "Data Scientists & AI Specialists experienced the highest headcount expansion (+104.2% from 12,000 to 24,500) and highest median monthly wage increase (+41.7% from SGD 7,200 to SGD 10,200). In contrast, IT Infrastructure roles grew more moderately (+23.4% headcount, +27.6% wage), highlighting shifting national demand towards generative and analytical capabilities.",
      "role_wage_growth": {
        "Cybersecurity Professionals": 33.8,
        "Data Scientists & AI Specialists": 41.7,
        "IT Infrastructure & Cloud Engineers": 27.6,
        "Product & Digital Transformation Managers": 30.7,
        "Software Engineers & Developers": 32.3
      },
      "role_headcount_growth": {
        "Cybersecurity Professionals": 58.9,
        "Data Scientists & AI Specialists": 104.2,
        "IT Infrastructure & Cloud Engineers": 23.4,
        "Product & Digital Transformation Managers": 50.0,
        "Software Engineers & Developers": 40.0
      },
      "ascii_chart": "Tech Wage Growth (2020 -> 2023 Median Gross Monthly SGD):\nData Science & AI:   $7,200 -> $10,200 (+41.7%) [===================]\nSoftware Engineers:  $6,500 -> $8,600  (+32.3%) [==============]\nCybersecurity:       $6,800 -> $9,100  (+33.8%) [===============]\nProduct & Digital:   $7,500 -> $9,800  (+30.7%) [==============] \nIT Infrastructure:   $5,800 -> $7,400  (+27.6%) [============]\n"
    },
    {
      "title": "Finding 3: SME Sectoral Digital Divide in AI Readiness",
      "summary": "While Financial Services SMEs lead with 56.0% AI adoption and 98.1% general digital solutions, traditional sectors lag behind: Food & Beverage (14.8% AI) and Construction (11.5% AI). This indicates targeted interventions are needed for low-margin service sectors.",
